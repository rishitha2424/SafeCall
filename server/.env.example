# Server Port
PORT=5000

# Excel Workbook Path (relative to server directory or root)
EXCEL_PATH=./child_spam_alert_demo_data.xlsx

# SendGrid API Configuration (Recommended for Render & Cloud - Port 443 HTTPS)
# 1. Create API key at: https://app.sendgrid.com/settings/api_keys
# 2. Verify your email in SendGrid Single Sender Verification: https://app.sendgrid.com/settings/sender_auth
SENDGRID_API_KEY=SG.your_sendgrid_api_key_here
SENDGRID_FROM="SafeFamily Alert" <rishitha.thoka@mobileum.com>

# SMTP Configuration for Real Email Alerts (Fallback if not using SendGrid)
# For Gmail: Use an App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-character-app-password
EMAIL_FROM="SafeFamily Telecom Security" <rishitha.thoka@mobileum.com>

# Optional delay for demo
SIMULATION_STEP_DELAY_MS=300

